# OAuth + verificación JWT — ver ADR-008 para la distinción exacta entre
# MONDAY_CLIENT_SECRET (session tokens de usuario y webhooks de ciclo de
# vida de la app) y MONDAY_SIGNING_SECRET (webhooks de board/integración).
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
NEXT_PUBLIC_MONDAY_CLIENT_ID=

# PostgreSQL / Supabase — pooler puerto 6543 (Transaction Mode) para la app,
# puerto 5432 directo exclusivo de migraciones.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://user:password@host:5432/postgres

# Bypasea RLS — exclusivamente server-side, nunca en el bundle de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Observabilidad (opcional en desarrollo)
SENTRY_DSN=
