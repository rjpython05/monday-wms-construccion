{
  "name": "monday-wms-construccion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .agents --ignore-pattern .claude/skills --ignore-pattern next-env.d.ts",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\" \"docker-compose.yml\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"*.{ts,mjs,json}\" \".github/**/*.{yml,yaml}\" \"docker-compose.yml\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v postgres && docker compose up -d postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky",
    "verify": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:unit && pnpm db:reset && pnpm db:migrate && pnpm test:int && pnpm test:security && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.0",
    "lint-staged": "^17.6.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
